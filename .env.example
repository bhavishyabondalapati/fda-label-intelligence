# Copy to .env and fill in real values. .env is gitignored. Never put real keys in this file.
# Phase 0 does not use any of these yet.

# AWS (Phase 2+). Profile and region are fixed for this project.
AWS_PROFILE=sky
AWS_REGION=us-east-2

# Pinecone (Phase 1+)
PINECONE_API_KEY=your-pinecone-api-key-here
PINECONE_INDEX=fda-labels
# Phase 2: Bedrock generation (profile/region come from AWS_PROFILE / AWS_REGION above)
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_PRICE_IN_PER_M=1.0
BEDROCK_PRICE_OUT_PER_M=5.0
BEDROCK_BUDGET_USD=0.90
