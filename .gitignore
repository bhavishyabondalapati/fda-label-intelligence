# Python environments and caches
venv/
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Secrets: real keys live only in .env
.env

# macOS
.DS_Store

# Data: raw downloads and processed files are rebuilt by scripts, never committed
data/raw/
data/processed/*
!data/processed/.gitkeep

# Local embedding caches
*.npy

# Local service pids/logs (make up)
.run/
*.pkl
data/finetune/

# Terraform local state and providers
.terraform/
*.tfstate*
crash.log

# Kaggle upload bundle (rebuilt by scripts/package_kaggle_dataset.py)
kaggle/dataset/
kaggle/*.zip
results/adapter/
